# Leave these blank for local development and for Vercel.
# Copy this file to .env.local and fill in only the values you need.

# GitHub Pages for a repository named "portfolio":
# VITE_BASE_PATH=/portfolio/
VITE_BASE_PATH=

# Public site URL with no trailing slash. Used for canonical, Open Graph, and sitemap links.
# Example: https://yourname.github.io/portfolio
VITE_SITE_URL=

# Optional EmailJS setup. Leave blank to use the mailto contact form.
# Template variables sent by the form: from_name, reply_to, subject, message.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
